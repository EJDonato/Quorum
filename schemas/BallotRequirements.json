{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "criterion_ids": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "required_checks": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "lint",
              "typecheck",
              "documentation",
              "scanner",
              "fuzz"
            ]
          },
          "command_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "check_id",
          "kind",
          "command_digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "policy_hash",
    "criterion_ids",
    "required_checks"
  ],
  "additionalProperties": false
}
