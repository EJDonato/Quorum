{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "agy",
            "codex"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "name",
        "version",
        "model"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "enforced",
        "advisory"
      ]
    },
    "validation_image": {
      "type": "string",
      "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
    },
    "commands": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "lint",
              "typecheck",
              "documentation",
              "scanner",
              "fuzz"
            ]
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "args": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          }
        },
        "required": [
          "check_id",
          "kind",
          "executable",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "permitted_environment_keys": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "implementation": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
          }
        },
        "tests": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
          }
        },
        "protected": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
          }
        },
        "sensitive": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
          }
        }
      },
      "required": [
        "implementation",
        "tests",
        "protected",
        "sensitive"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "repairs_per_stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repairs_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invocation_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "check_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "active_session_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repairs_per_stage",
        "repairs_total",
        "invocation_timeout_ms",
        "check_timeout_ms",
        "active_session_ms",
        "model_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "mode",
    "validation_image",
    "commands",
    "permitted_environment_keys",
    "paths",
    "budgets"
  ],
  "additionalProperties": false
}
