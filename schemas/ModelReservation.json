{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_tokens_bound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tokens_reserved": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "request_id",
    "payload_digest",
    "capability_digest",
    "input_tokens_bound",
    "output_tokens_limit",
    "tokens_reserved"
  ],
  "additionalProperties": false
}
