{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "baseline",
            "expected_red"
          ]
        },
        "baseline_tree": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "const": "sha1"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "format",
                "oid"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "const": "sha256"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "format",
                "oid"
              ],
              "additionalProperties": false
            }
          ]
        },
        "tree": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "const": "sha1"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "format",
                "oid"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "const": "sha256"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "format",
                "oid"
              ],
              "additionalProperties": false
            }
          ]
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "motion_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "specification_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "phase",
        "baseline_tree",
        "tree",
        "configuration_digest",
        "environment_digest",
        "motion_digest",
        "specification_digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "input_digest",
    "identity"
  ],
  "additionalProperties": false
}
