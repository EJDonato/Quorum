{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "instructions": {
      "type": "string",
      "maxLength": 65536
    },
    "input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "tools": {
      "minItems": 0,
      "maxItems": 0,
      "type": "array",
      "items": {
        "not": {}
      }
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stream": {
      "type": "boolean",
      "const": false
    },
    "store": {
      "type": "boolean",
      "const": false
    },
    "truncation": {
      "type": "string",
      "const": "disabled"
    },
    "tool_choice": {
      "type": "string",
      "const": "none"
    },
    "parallel_tool_calls": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "model",
    "instructions",
    "input",
    "tools",
    "max_output_tokens",
    "stream",
    "store",
    "truncation",
    "tool_choice",
    "parallel_tool_calls"
  ],
  "additionalProperties": false
}
