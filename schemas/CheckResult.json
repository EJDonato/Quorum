{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "check_result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "baseline"
            },
            "input_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "phase",
            "input_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "expected_red"
            },
            "input_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "phase",
            "input_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "final"
            },
            "candidate_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "phase",
            "candidate_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "test",
        "lint",
        "typecheck",
        "documentation",
        "scanner",
        "fuzz"
      ]
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "PROTOCOL_ERROR"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "command_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stdout_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "digest"
      ],
      "additionalProperties": false
    },
    "stderr_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "digest"
      ],
      "additionalProperties": false
    },
    "report_complete": {
      "type": "boolean"
    },
    "discovered_tests": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "error_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failure_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "behavioral",
            "compiler",
            "infrastructure"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fuzz": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cases_required": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "cases_completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "seed",
            "cases_required",
            "cases_completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "check_result_id",
    "session_id",
    "check_id",
    "input",
    "kind",
    "execution_status",
    "exit_code",
    "duration_ms",
    "started_at",
    "ended_at",
    "command_digest",
    "environment_digest",
    "tool_version",
    "stdout_ref",
    "stderr_ref",
    "report_complete",
    "discovered_tests",
    "error_count",
    "warning_count",
    "failure_class",
    "fuzz"
  ],
  "additionalProperties": false
}
