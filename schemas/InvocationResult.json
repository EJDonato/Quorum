{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "PROTOCOL_ERROR"
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "charged_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "accounting_complete": {
              "type": "boolean"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cached_input_tokens",
            "reasoning_tokens",
            "charged_tokens",
            "accounting_complete"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "output_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "CAPABILITY_MISSING",
                "SCOPE_DENIED",
                "STALE_INPUT",
                "LOCKED",
                "BUDGET_EXHAUSTED",
                "CHECK_FAILED",
                "REVIEW_REJECTED",
                "EVIDENCE_INVALID",
                "SOURCE_DIVERGED",
                "STORAGE_FAILED",
                "CANCELLED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "retryable": {
              "type": "boolean"
            },
            "remediation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "details_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "remediation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "protocol_version",
    "invocation_id",
    "session_id",
    "input_digest",
    "execution_status",
    "usage",
    "output_ref",
    "error",
    "started_at",
    "ended_at"
  ],
  "additionalProperties": false
}
