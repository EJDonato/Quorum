{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_complete": {
      "type": "boolean"
    },
    "discovered_tests": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "error_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failure_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "behavioral",
            "compiler",
            "infrastructure"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "failure_ids": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "fuzz": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cases_required": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "cases_completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "seed",
            "cases_required",
            "cases_completed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "report_complete",
    "discovered_tests",
    "error_count",
    "warning_count",
    "failure_class",
    "tool_version",
    "fuzz"
  ],
  "additionalProperties": false
}
