{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "design"
            },
            "role": {
              "type": "string",
              "const": "security"
            },
            "contract_input_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "phase",
            "role",
            "contract_input_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "final"
            },
            "role": {
              "type": "string",
              "enum": [
                "qa",
                "security"
              ]
            },
            "candidate_id": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "phase",
            "role",
            "candidate_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "PROTOCOL_ERROR"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "const": "APPROVED"
            },
            "findings": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "blocking",
                      "warning",
                      "info"
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidence_refs": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "artifact_id",
                        "digest"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "criterion_id",
                  "severity",
                  "path",
                  "message",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "evidence_refs": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "artifact_id",
                  "digest"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "verdict",
            "findings",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "const": "REJECTED"
            },
            "findings": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "blocking",
                      "warning",
                      "info"
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidence_refs": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "artifact_id",
                        "digest"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "criterion_id",
                  "severity",
                  "path",
                  "message",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "evidence_refs": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "artifact_id",
                  "digest"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "verdict",
            "findings",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "const": "INCOMPLETE"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "findings": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "blocking",
                      "warning",
                      "info"
                    ]
                  },
                  "path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$).+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidence_refs": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "artifact_id",
                        "digest"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "criterion_id",
                  "severity",
                  "path",
                  "message",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "evidence_refs": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "artifact_id",
                  "digest"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "verdict",
            "reason",
            "findings",
            "evidence_refs"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "invocation_id",
    "input_digest",
    "subject",
    "execution_status",
    "submitted_at",
    "body"
  ],
  "additionalProperties": false
}
