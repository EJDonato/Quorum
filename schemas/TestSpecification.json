{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "motion_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mappings": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "expectation": {
                "type": "string",
                "const": "behavioral"
              },
              "expected_failure_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              }
            },
            "required": [
              "criterion_id",
              "check_id",
              "expectation",
              "expected_failure_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "expectation": {
                "type": "string",
                "const": "compiler"
              },
              "expected_failure_id": {
                "type": "string",
                "enum": [
                  "TS2322",
                  "TS2345",
                  "TS2416",
                  "TS2741"
                ]
              }
            },
            "required": [
              "criterion_id",
              "check_id",
              "expectation",
              "expected_failure_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "expectation": {
                "type": "string",
                "const": "regression"
              },
              "justification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "criterion_id",
              "check_id",
              "expectation",
              "justification"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "expectation": {
                "type": "string",
                "const": "documentation"
              },
              "justification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "criterion_id",
              "check_id",
              "expectation",
              "justification"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "motion_digest",
    "mappings"
  ],
  "additionalProperties": false
}
