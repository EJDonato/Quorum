{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "base_commit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "const": "sha1"
            },
            "oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "format",
            "oid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "const": "sha256"
            },
            "oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "format",
            "oid"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "enforced",
        "advisory"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PREFLIGHT",
        "PLANNING",
        "DESIGN_REVIEW",
        "TEST_SPEC",
        "IMPLEMENTING",
        "VALIDATING",
        "REVIEWING",
        "APPROVED",
        "FINALIZING",
        "COMPLETED",
        "BLOCKED",
        "CANCELLED",
        "ABORTED"
      ]
    },
    "state_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current_candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "repairs_per_stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repairs_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invocation_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "check_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "active_session_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repairs_per_stage",
        "repairs_total",
        "invocation_timeout_ms",
        "check_timeout_ms",
        "active_session_ms",
        "model_tokens"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "repairs_by_stage": {
          "type": "object",
          "properties": {
            "PLANNING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "DESIGN_REVIEW": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "TEST_SPEC": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "IMPLEMENTING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "VALIDATING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "REVIEWING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "PLANNING",
            "DESIGN_REVIEW",
            "TEST_SPEC",
            "IMPLEMENTING",
            "VALIDATING",
            "REVIEWING"
          ],
          "additionalProperties": false
        },
        "repairs_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_charged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repairs_by_stage",
        "repairs_total",
        "tokens_charged",
        "active_elapsed_ms"
      ],
      "additionalProperties": false
    },
    "blocking_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "repository_id",
    "base_commit",
    "mode",
    "state",
    "state_sequence",
    "current_candidate_id",
    "input_digest",
    "limits",
    "budget",
    "blocking_reason"
  ],
  "additionalProperties": false
}
